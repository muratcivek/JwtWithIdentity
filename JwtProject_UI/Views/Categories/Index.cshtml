@model List<JwtProject_UI.DTOs.Categories.ResultCategoryDto>

@{
    ViewData["Title"] = "Kategoriler";
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Kategoriler - JWT Project</title>

    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                background: #f3f4f6;
                color: #1f2937;
            }

            .container {
                max-width: 1100px;
                margin: 50px auto;
                padding: 0 20px;
            }

            .page-header {
                margin-bottom: 25px;
            }

                .page-header h2 {
                    font-size: 26px;
                    margin-bottom: 8px;
                }

                .page-header p {
                    color: #6b7280;
                    font-size: 14px;
                }

            .card {
                background: #fff;
                border-radius: 10px;
                padding: 25px;
                box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            }

            .card-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                flex-wrap: wrap;
                gap: 15px;
                margin-bottom: 20px;
            }

            .category-count {
                font-size: 14px;
                color: #6b7280;
            }

                .category-count strong {
                    color: #2563eb;
                }

            .search-input {
                width: 280px;
                max-width: 100%;
                padding: 11px 14px;
                border: 1px solid #d1d5db;
                border-radius: 6px;
                font-size: 14px;
                outline: none;
            }

                .search-input:focus {
                    border-color: #2563eb;
                }

            .table-wrapper {
                width: 100%;
                overflow-x: auto;
            }

            table {
                width: 100%;
                border-collapse: collapse;
            }

            thead {
                background: #f9fafb;
            }

            th {
                padding: 15px;
                font-size: 13px;
                font-weight: 600;
                text-align: left;
                color: #374151;
                border-bottom: 1px solid #e5e7eb;
            }

            td {
                padding: 15px;
                font-size: 14px;
                border-bottom: 1px solid #e5e7eb;
            }

            tbody tr:hover {
                background: #f9fafb;
            }

            tbody tr:last-child td {
                border-bottom: none;
            }

            .id-badge {
                display: inline-block;
                padding: 5px 10px;
                background: #eff6ff;
                color: #2563eb;
                border-radius: 5px;
                font-weight: 600;
                font-size: 12px;
            }

            .empty-message {
                text-align: center;
                padding: 35px;
                color: #6b7280;
                font-size: 14px;
            }

            .table-footer {
                margin-top: 20px;
                font-size: 13px;
                color: #6b7280;
            }

            @@media (max-width: 600px) {
                .container {
                    margin: 25px auto;
                }

                .card {
                    padding: 15px;
                }

                .search-input {
                    width: 100%;
                }

                .card-header {
                    align-items: stretch;
                    flex-direction: column;
                }
            }
    </style>
</head>

<body>

    <div class="container">

        <div class="page-header">
            <h2>Kategoriler</h2>
            <p>Sistemde kayıtlı kategorileri görüntüleyebilirsiniz.</p>
        </div>

        <div class="card">

            <div class="card-header">

                <div class="category-count">
                    Toplam Kategori:
                    <strong>@(Model?.Count ?? 0)</strong>
                </div>

                <input type="text"
                       id="searchInput"
                       class="search-input"
                       placeholder="Kategori ara..." />
            </div>

            <div class="table-wrapper">
                <table id="categoryTable">

                    <thead>
                        <tr>
                            <th style="width: 120px;">ID</th>
                            <th>Kategori Adı</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var category in Model)
                            {
                                <tr>
                                    <td>
                                        <span class="id-badge">
                                            #@category.Id
                                        </span>
                                    </td>

                                    <td>@category.Name</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="2" class="empty-message">
                                    Henüz kategori bulunmuyor.
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

            <div class="table-footer">
                Gösterilen kategori:
                <strong id="visibleCount">@(Model?.Count ?? 0)</strong>
            </div>

        </div>

    </div>

    <script>
            document.addEventListener("DOMContentLoaded", function() {

                const searchInput = document.getElementById("searchInput");
                const table = document.getElementById("categoryTable");
                const rows = table.querySelectorAll("tbody tr");
                const visibleCount = document.getElementById("visibleCount");

                searchInput.addEventListener("input", function() {

                    const searchValue = this.value
                        .toLocaleLowerCase("tr-TR")
                        .trim();

                    let count = 0;

                    rows.forEach(function(row) {

                        const cells = row.querySelectorAll("td");

                        if (cells.length < 2) {
                            return;
                        }

                        const categoryName = cells[1].textContent
                            .toLocaleLowerCase("tr-TR");

                        const isVisible = categoryName.includes(searchValue);

                        row.style.display = isVisible ? "" : "none";

                        if (isVisible) {
                            count++;
                        }
                    });

                    visibleCount.textContent = count;
                });

            });
    </script>

</body>
</html>